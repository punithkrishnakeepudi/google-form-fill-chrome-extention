{
  "manifest_version": 3,
  "name": "Google Form Autofill",
  "version": "1.1",
  "description": "Fills Google Forms with your saved details and learns new answers.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://docs.google.com/forms/*"], "js": ["content.js"] }
  ]
}
